+  // Experimental data-free score. Translate the local CDF to zero and
+  // compare before/after cubics on the four affected old intervals.
+  struct JoinCurve {
+    std::array<Node, 7> nodes{};
+    std::size_t used = 0;
+    Node& operator[](std::size_t i) { return nodes[i]; }
+    const Node& operator[](std::size_t i) const { return nodes[i]; }
+    auto begin() { return nodes.begin(); }
+    auto end() { return nodes.begin() + static_cast<std::ptrdiff_t>(used); }
+    auto begin() const { return nodes.begin(); }
+    auto end() const { return nodes.begin() + static_cast<std::ptrdiff_t>(used); }
+    Node& back() { return nodes[used - 1]; }
+    std::size_t size() const { return used; }
+  };
+  static long double curve_rank(const JoinCurve& curve, double x) {
+    if (x <= curve[0].x) return curve[0].prefix;
+    if (x >= curve.nodes[curve.used - 1].x) return curve.nodes[curve.used - 1].prefix;
+    const auto it = std::lower_bound(curve.begin(), curve.end(), x,
+        [](const Node& node, double value) { return node.x < value; });
+    if (it->x == x) return it->prefix;
+    const auto& left = *(it - 1); const auto& right = *it;
+    const long double t = fraction(left.x, right.x, x);
+    const long double h = static_cast<long double>(right.x) - left.x;
+    const auto dl = h * left.slope, dr = h * right.slope;
+    if (!std::isfinite(dl) || !std::isfinite(dr)) return left.prefix + t * right.mass;
+    return std::clamp(left.prefix + (3 * t * t - 2 * t * t * t) * right.mass +
+        t * (1 - t) * ((1 - t) * dl - t * dr), left.prefix, right.prefix);
+  }
+  static long double join_curve_score(JoinCurve original, std::size_t removed) {
+    original[0].mass = 0;
+    auto joined = original;
+    joined[removed + 1].mass += joined[removed].mass;
+    for (std::size_t i = removed; i + 1 < joined.used; ++i) joined[i] = joined[i + 1];
+    --joined.used;
+    SplineSketch::rebuild(original); SplineSketch::rebuild(joined);
+    const auto first = removed > 1 ? removed - 2 : 0;
+    const auto last = std::min(original.used - 1, removed + 2);
+    long double score = 0;
+    for (std::size_t i = first + 1; i <= last; ++i)
+      for (unsigned j = 0; j <= 16; ++j) {
+        const long double t = static_cast<long double>(j) / 16;
+        const double x = static_cast<double>((1 - t) * original[i - 1].x + t * original[i].x);
+        const auto difference = std::fabs(curve_rank(original, x) - curve_rank(joined, x));
+        if (!std::isfinite(difference)) return std::numeric_limits<long double>::max();
+        score = std::max(score, difference);
+      }
+    return score;
