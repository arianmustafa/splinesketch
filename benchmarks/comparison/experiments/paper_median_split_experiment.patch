+  double split_position(const Node& left, const Node& right, const Snapshot& before) const {
+    const double mid = midpoint(left.x, right.x);
+    if constexpr (!TrackBounds) return mid;
+    else {
+      if (before.items.empty()) return mid;
+      const auto first = std::upper_bound(before.items.begin(), before.items.end(), left.x,
+          [](double value, const Item& item) { return value < item.first; });
+      const auto last = std::lower_bound(first, before.items.end(), right.x,
+          [](const Item& item, double value) { return item.first < value; });
+      if (first == last) return mid;
+      const auto low = static_cast<std::size_t>(first - before.items.begin());
+      const auto high = static_cast<std::size_t>(last - before.items.begin());
+      const auto base = low ? before.sums[low - 1] : 0;
+      const auto weight = before.sums[high - 1] - base;
+      const auto target = base + weight / 2 + weight % 2;
+      const auto at = std::lower_bound(before.sums.begin() + static_cast<std::ptrdiff_t>(low),
+          before.sums.begin() + static_cast<std::ptrdiff_t>(high), target);
+      const double candidate = before.items[static_cast<std::size_t>(at - before.sums.begin())].first;
+      const auto t = fraction(left.x, right.x, candidate);
+      if (!(t >= 0.25L && t <= 0.75L)) return mid;
+      const auto score = [&](double x) {
+        const auto bound = before.bounds(x);
+        return std::max({bound.upper - bound.lower,
+                         bound.upper - before.atom(x) - left.lower,
+                         right.upper - right.atom - bound.lower});
+      };
+      return score(candidate) < score(mid) ? candidate : mid;
+    }
+  }
